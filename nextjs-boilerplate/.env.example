# This stays server-only. The browser sends auth requests to /api/auth instead.
AUTH_SERVICE_URL=http://localhost:4000
# Project requests follow the same server-only proxy pattern.
PROJECT_SERVICE_URL=http://localhost:3000
# Local host-run Docker controller; this URL is server-only, never a public API key.
EXECUTION_SERVICE_URL=http://127.0.0.1:5002
# Label only: does NOT disable paid calls. demo:local supplies it with isolated fixture rewrites.
AGENTFORGE_LOCAL_DEMO=0
