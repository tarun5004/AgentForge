FROM node:22-alpine

WORKDIR /app

# npm workspaces use the root lockfile, not a separate frontend dependency install.
COPY package.json package-lock.json ./
COPY auth-service/package.json ./auth-service/package.json
COPY project-service/package.json ./project-service/package.json
COPY ai-orchestrator-service/package.json ./ai-orchestrator-service/package.json
COPY execution-service/package.json ./execution-service/package.json
COPY nextjs-boilerplate/package.json ./nextjs-boilerplate/package.json

RUN npm ci --workspace nextjs-boilerplate

# Next writes its development cache here, so this directory belongs to the runtime user.
COPY --chown=node:node nextjs-boilerplate ./nextjs-boilerplate
WORKDIR /app/nextjs-boilerplate

# The earlier package.json COPY already created this parent directory as root.
# COPY --chown owns the copied files, but Next must also create cache/generated files here.
RUN chown -R node:node /app/nextjs-boilerplate

USER node
EXPOSE 3001

CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0"]
