{
  "name": "loveable-main",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "auth-service",
    "project-service",
    "ai-orchestrator-service",
    "execution-service",
    "nextjs-boilerplate"
  ],
  "scripts": {
    "dev:auth": "npm --workspace auth-service run dev",
    "dev:project": "npm --workspace project-service run dev",
    "dev:ai": "npm --workspace ai-orchestrator-service run dev",
    "dev:execution": "npm --workspace execution-service run dev",
    "dev:web": "npm --workspace nextjs-boilerplate run dev",
    "build:auth": "npm --workspace auth-service run build",
    "build:project": "npm --workspace project-service run build",
    "build:ai": "npm --workspace ai-orchestrator-service run build",
    "build:execution": "npm --workspace execution-service run build",
    "build:web": "npm --workspace nextjs-boilerplate run build",
    "test:fixture-cleanup": "node --experimental-strip-types --test tests/fixture-cleanup.test.mts",
    "test:browser-links": "powershell -NoProfile -File scripts/verify-workspace-links.ps1",
    "test:browser-history": "powershell -NoProfile -File scripts/verify-workspace-links.ps1 -Suite history",
    "test:browser-access": "powershell -NoProfile -File scripts/verify-workspace-links.ps1 -Suite access"
  }
}
