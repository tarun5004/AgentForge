NODE_ENV=development
PORT=5000
LOG_LEVEL=info

REDIS_URL=redis://127.0.0.1:6379

# Opt-in host-run local demo only. Never mount the Docker socket into the web/API containers.
LOCAL_PREVIEW_ENABLED=false
PREVIEW_PORT=5101
# Optional exact browser origin when the frontend uses a different local port.
# Unset preserves localhost:3001 and 127.0.0.1:3001; a configured value replaces both.
# PREVIEW_FRONTEND_ORIGIN=http://localhost:3001
PREVIEW_RUNNER_IMAGE=agentforge-preview-runner:local
# The existing frontend proxy can reach the Compose-internal Project Service.
PROJECT_SERVICE_URL=http://127.0.0.1:3001
# Optional server-to-server candidate checks. Same random secret in Project Service; never NEXT_PUBLIC.
# Requires LOCAL_PREVIEW_ENABLED=true. Leave unset until Project candidate routes are deployed.
# EXECUTION_CHECK_TOKEN=<32-to-256-random-url-safe-characters>
