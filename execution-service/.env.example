NODE_ENV=development
PORT=5000
LOG_LEVEL=info

REDIS_URL=redis://127.0.0.1:6379

# Opt-in host-run local demo only. Never mount the Docker socket into the web/API containers.
LOCAL_PREVIEW_ENABLED=false
PREVIEW_PORT=5101
PREVIEW_RUNNER_IMAGE=agentforge-preview-runner:local
# The existing frontend proxy can reach the Compose-internal Project Service.
PROJECT_SERVICE_URL=http://127.0.0.1:3001
