{
  "name": "execution-service",
  "version": "1.0.0",
  "private": true,
  "description": "AgentForge isolated code execution service",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx --test src/features/runs/*.test.ts tests/*.test.mjs",
    "test:docker": "tsx --test tests/docker.integration.ts",
    "test:preview-browser": "tsx --test tests/preview-frame.integration.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2"
  }
}
