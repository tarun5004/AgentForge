PORT=6001
# gateway preserves the existing connection. Set google for direct Google AI Studio usage.
AI_PROVIDER=gateway
AI_GATEWAY_API_KEY=add_your_vercel_ai_gateway_key
INTERNAL_SERVICE_TOKEN=use_the_same_random_value_in_project_service
# Free-credit eligible when checked on 2026-10-23; usage still consumes Gateway credits.
# Recheck eligibility/pricing before use. Change the model without editing application code.
AI_MODEL=google/gemini-2.5-flash
# Direct Google alternative: AI_PROVIDER=google, AI_MODEL=gemini-3.5-flash-lite
# GOOGLE_GENERATIVE_AI_API_KEY=add_your_google_ai_studio_key
# Keep the Google project on Free tier; selecting a model does not enforce billing limits.
# Zero-cost local TF-IDF retrieval is the default. Semantic mode adds Google embedding calls.
RAG_RETRIEVAL_MODE=lexical
# To opt in: set semantic, a current supported Google embedding model ID, and the Google key above.
# RAG_EMBEDDING_MODEL=replace_with_a_supported_google_embedding_model_id
