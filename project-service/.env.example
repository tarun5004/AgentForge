PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/project-service
ACCESS_TOKEN_SECRET=use_the_same_access_secret_as_auth_service
AI_ORCHESTRATOR_URL=http://localhost:6001
INTERNAL_SERVICE_TOKEN=use_the_same_random_value_in_ai_orchestrator_service

# Opt-in trusted-host build gate; requires the compatible Execution candidate endpoint.
# Captured per new attempt: disabling later cannot bypass checks on existing gated candidates.
BUILD_GATE_ENABLED=false
EXECUTION_SERVICE_URL=http://127.0.0.1:5100
# Separate from JWT/AI tokens. Same random secret as host Execution; never NEXT_PUBLIC.
# EXECUTION_CHECK_TOKEN=<32-to-256-random-url-safe-characters>
