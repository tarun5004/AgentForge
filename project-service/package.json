{
  "name": "project-service",
  "version": "1.0.0",
  "description": "AgentForge project lifecycle and orchestration service",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false ./src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx --test src/config/env.test.ts src/services/project-read.validation.test.ts src/services/generation-request.test.ts src/services/revision-files.test.ts src/clients/generation.contract.test.ts src/clients/build-verification.test.ts src/clients/execution.client.test.ts src/clients/requirement.contract.test.ts src/clients/conversation.client.test.ts",
    "test:integration": "tsx --test src/routes/project.routes.integration.test.ts",
    "test:build-gate": "tsx --test src/routes/build-gate.integration.test.ts",
    "test:brief": "tsx --test src/routes/brief.routes.integration.test.ts",
    "test:conversation": "tsx --test src/routes/conversation.routes.integration.test.ts",
    "test:chat-history": "tsx --test src/routes/conversation-history.integration.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.1",
    "morgan": "^1.11.0",
    "zod": "^4.6.5"
  }
}
